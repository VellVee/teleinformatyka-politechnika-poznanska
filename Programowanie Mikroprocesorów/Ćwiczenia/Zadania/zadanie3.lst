     1                  ; <etykieta><rozkaz><parametry><;komentarz>
     2                  ; Migotanie diody 
     3                  
     4                  	; Początek każdego programu
     5  0000: 02 01 00  	LJMP START		
     6  0100:           	ORG	100H
     7                  
     8  0100:           START:
     9  0100: 74 0A     	MOV A, #10 ; przeniesienie do akumulatora, po '#' dajemy wartość liczbową - 
    10                  			   ; to można dać przed pętle, ale podprogram może modyfikować zawartość akumulatora
    11  0102: 12 81 12  	LCALL DELAY_100MS	; wywołujemy podprogram DELAY_100MS, który opóźnia o sekunde (o wartość z akumulatora)
    12  0105: B2 97     	CPL P1.7	; negujemy bit P1.7 - dioda się raz zapala, a raz nie
    13  0107: B2 95     	CPL P1.5
    14  0109: 80 F5     	SJMP START ; dalej są śmieci - robimy pętle do STARTu
